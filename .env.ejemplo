# ============================================================
#  TruckManager Pro — Variables de entorno (ejemplo)
#  Copiar a .env y completar con valores reales.
#  NUNCA subir .env al repositorio.
# ============================================================

# ── Oracle Autonomous Database ───────────────────────────────
ORACLE_TNS_NAME=bdjvalencia_low
ORACLE_WALLET_PATH=/ruta/al/wallet   # ruta local donde está el wallet descomprimido
ORACLE_USUARIO=ADMIN
ORACLE_CLAVE=tu_clave_aqui
ORACLE_ESQUEMA=ADMIN

# ── Azure AD B2C ─────────────────────────────────────────────
AZURE_B2C_TENANT=trackmanager

# ── Azure Service Bus ────────────────────────────────────────
AZURE_BUS_SERVICIO_CONEXION=Endpoint=sb://sb-truckmanagercl.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=tu_clave_aqui
